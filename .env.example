# Game server (server/). Production refuses to start without the first three.
SESSION_SECRET=            # 32+ random characters: openssl rand -base64 48
ZEND_APP_KEY=zapp_sk_...   # from POST /api/zend/v2/apps (shown once)
ZEND_WEBHOOK_SECRET=       # from the same call
ZEND_API=https://api.usezend.app
ZEND_APP_SLUG=owambe
PORT=8787
WEB_DIR=../web/dist        # serve the page from this server (one origin)
DATA_DIR=data              # events.jsonl (metrics, reports) and avoid.json
FRAME_ANCESTORS=https://app.usezend.app
# CORS_ORIGINS=https://owambe.example.com   # only if the page is hosted elsewhere

# Tuning (PRD open questions; defaults shown)
ROUND_SECS=120
READY_SECS=5
VOTE_SECS=20
RESULTS_SECS=45
ROOM_SIZE=6
QUEUE_WAIT_SECS=8
REMATCH_WAIT_SECS=12
LABEL_BOTS=1

# Page build (web/), read by Vite
# VITE_ZEND_ORIGINS=https://app.usezend.app,https://staging.usezend.app
# VITE_ZEND_SLUG=owambe
# VITE_API_BASE=            # empty = same origin
